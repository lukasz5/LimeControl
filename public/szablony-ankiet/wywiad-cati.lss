  <rows>
   <row>
    <qid><![CDATA[1]]></qid>
    <language><![CDATA[pl]]></language>
    <question><![CDATA[<strong>ANKIETER — odczytaj:</strong> Dzień dobry, nazywam się [imię i nazwisko] i dzwonię z [nazwa firmy]. Prowadzimy krótkie badanie na temat [temat]. Rozmowa potrwa około 8 minut. Czy mogę zadać Panu/Pani kilka pytań?]]></question>
    <help><![CDATA[]]></help>
    <script><![CDATA[]]></script>
   </row>
   <row>
    <qid><![CDATA[1]]></qid>
    <language><![CDATA[en]]></language>
    <question><![CDATA[<strong>INTERVIEWER — read out:</strong> Good morning, my name is [name] and I am calling from [company]. We are conducting a short survey about [topic]. It will take about 8 minutes. May I ask you a few questions?]]></question>
    <help><![CDATA[]]></help>
    <script><![CDATA[]]></script>
   </row>
   <row>
    <qid><![CDATA[2]]></qid>
    <language><![CDATA[pl]]></language>
    <question><![CDATA[Wynik kontaktu]]></question>
    <help><![CDATA[ANKIETER: nie odczytuj. Zaznacz wynik próby kontaktu.]]></help>
    <script><![CDATA[]]></script>
