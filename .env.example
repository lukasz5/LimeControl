# LimeControl — przykładowa konfiguracja / example configuration.
# Skopiuj do .env (plik .env nie trafia do repozytorium). / Copy to .env (never committed).
# Zestaw Docker dla własnego serwera ma osobny plik: deploy/selfhost/.env.example

# ---------------------------------------------------------------------------
# Serwer (Express) — czytane przy starcie / read at start-up
# ---------------------------------------------------------------------------

# Tryb logowania: "local" (klucz dostępu) albo "firebase" (konto Google).
# Puste = firebase, gdy istnieje firebase-applet-config.json; w przeciwnym razie local.
# Sign-in mode. Empty = firebase when firebase-applet-config.json exists, otherwise local.
AUTH_MODE=""

# Tryb local: klucz logowania, minimum 16 znaków (np. openssl rand -base64 24).
# Pusty = klucz zostanie wygenerowany przy pierwszym starcie i zapisany w data/access-key.
# Local mode: the sign-in key, at least 16 characters. Empty = generated on first start.
LIMECONTROL_ACCESS_KEY=""

# Materiał klucza do szyfrowania haseł zadań harmonogramu (min. 16 znaków).
# Pusty = klucz w pliku data/secret.key.
# Key material for encrypting scheduled-job passwords. Empty = a key file in data/secret.key.
LIMECONTROL_SECRET=""

# 1 = przekaźnik i harmonogram mogą łączyć się z adresami prywatnymi i localhost.
# Domyślnie włączone w trybie local, wyłączone w trybie firebase.
# 1 = the relay and the scheduler may reach private addresses. Default: on in local mode, off in firebase mode.
RELAY_ALLOW_PRIVATE=""

# Port i katalog danych (kolejka harmonogramu, klucze). / Port and data directory.
PORT="3000"
DATA_DIR="data"

# ---------------------------------------------------------------------------
# Budowanie aplikacji (Vite) — wartości trafiają do kodu przeglądarki / baked into the browser bundle
# ---------------------------------------------------------------------------

# "local" buduje aplikację bez konfiguracji Firebase (własna instalacja).
# "local" builds the app without any Firebase configuration (self-hosting).
VITE_AUTH_MODE=""

# Link „Postaw mi kawę” (np. PayPal.me). Pusty = domyślny profil PayPal strefabadan.pl.
# The "Buy me a coffee" link. Empty = the default strefabadan.pl PayPal profile.
VITE_SUPPORT_URL=""

# Linki do aplikacji LimeControl w sklepach (puste = przycisk „Wkrótce”).
# Store links for the LimeControl mobile app (empty = a "Coming soon" button).
VITE_APP_STORE_URL=""
VITE_PLAY_STORE_URL=""
