  </fields>
  <rows>
   <row>
    <surveyls_survey_id><![CDATA[100080]]></surveyls_survey_id>
    <surveyls_language><![CDATA[pl]]></surveyls_language>
    <surveyls_title><![CDATA[Satysfakcja pacjenta po wizycie]]></surveyls_title>
    <surveyls_description><![CDATA[Ankieta dotyczy Twojej ostatniej wizyty. Jest anonimowa i zajmie około 5 minut.]]></surveyls_description>
    <surveyls_welcometext><![CDATA[Nie pytamy o stan zdrowia ani dane osobowe. Twoje odpowiedzi pomogą nam poprawić jakość opieki.]]></surveyls_welcometext>
    <surveyls_endtext><![CDATA[Dziękujemy za wypełnienie ankiety. Życzymy zdrowia!]]></surveyls_endtext>
    <surveyls_url><![CDATA[]]></surveyls_url>
    <surveyls_urldescription><![CDATA[]]></surveyls_urldescription>
    <surveyls_email_invite_subj><![CDATA[Zaproszenie do ankiety: {SURVEYNAME}]]></surveyls_email_invite_subj>
    <surveyls_email_invite><![CDATA[Dzień dobry {FIRSTNAME},<br /><br />zapraszamy do wypełnienia ankiety „{SURVEYNAME}”.<br /><br />{SURVEYDESCRIPTION}<br /><br />Aby wziąć udział, kliknij w link:<br />{SURVEYURL}<br /><br />Z poważaniem<br />{ADMINNAME} ({ADMINEMAIL})<br /><br />----------------------------------------------<br />Jeśli nie chcesz brać udziału w tej ankiecie i otrzymywać kolejnych zaproszeń, kliknij:<br />{OPTOUTURL}]]></surveyls_email_invite>
    <surveyls_email_remind_subj><![CDATA[Przypomnienie o ankiecie: {SURVEYNAME}]]></surveyls_email_remind_subj>
    <surveyls_email_remind><![CDATA[Dzień dobry {FIRSTNAME},<br /><br />niedawno zaprosiliśmy Cię do ankiety „{SURVEYNAME}”. Nie mamy jeszcze Twoich odpowiedzi — ankieta jest nadal dostępna:<br />{SURVEYURL}<br /><br />Z poważaniem<br />{ADMINNAME} ({ADMINEMAIL})<br /><br />----------------------------------------------<br />Jeśli nie chcesz otrzymywać kolejnych przypomnień, kliknij:<br />{OPTOUTURL}]]></surveyls_email_remind>
    <surveyls_email_register_subj><![CDATA[Potwierdzenie rejestracji w ankiecie: {SURVEYNAME}]]></surveyls_email_register_subj>
    <surveyls_email_register><![CDATA[Dzień dobry {FIRSTNAME},<br /><br />dziękujemy za rejestrację w ankiecie „{SURVEYNAME}”. Aby ją wypełnić, kliknij w link:<br />{SURVEYURL}<br /><br />Z poważaniem<br />{ADMINNAME} ({ADMINEMAIL})]]></surveyls_email_register>
    <surveyls_email_confirm_subj><![CDATA[Potwierdzenie udziału w ankiecie: {SURVEYNAME}]]></surveyls_email_confirm_subj>
    <surveyls_email_confirm><![CDATA[Dzień dobry {FIRSTNAME},<br /><br />dziękujemy za wypełnienie ankiety „{SURVEYNAME}”. Twoje odpowiedzi zostały zapisane.<br /><br />Z poważaniem<br />{ADMINNAME}]]></surveyls_email_confirm>
    <surveyls_dateformat><![CDATA[1]]></surveyls_dateformat>
    <surveyls_attributecaptions><![CDATA[]]></surveyls_attributecaptions>
    <surveyls_numberformat><![CDATA[1]]></surveyls_numberformat>
   </row>
   <row>
    <surveyls_survey_id><![CDATA[100080]]></surveyls_survey_id>
    <surveyls_language><![CDATA[en]]></surveyls_language>
    <surveyls_title><![CDATA[Patient satisfaction after a visit]]></surveyls_title>
    <surveyls_description><![CDATA[This survey is about your most recent visit. It is anonymous and takes about 5 minutes.]]></surveyls_description>
    <surveyls_welcometext><![CDATA[We do not ask about your health or personal data. Your answers will help us improve the quality of care.]]></surveyls_welcometext>
    <surveyls_endtext><![CDATA[Thank you for completing the survey. We wish you good health!]]></surveyls_endtext>
    <surveyls_url><![CDATA[]]></surveyls_url>
    <surveyls_urldescription><![CDATA[]]></surveyls_urldescription>
    <surveyls_email_invite_subj><![CDATA[Invitation to participate in a survey: {SURVEYNAME}]]></surveyls_email_invite_subj>
    <surveyls_email_invite><![CDATA[Dear {FIRSTNAME},<br /><br />you have been invited to take part in the survey "{SURVEYNAME}".<br /><br />{SURVEYDESCRIPTION}<br /><br />To participate, please click the link below:<br />{SURVEYURL}<br /><br />Sincerely,<br />{ADMINNAME} ({ADMINEMAIL})<br /><br />----------------------------------------------<br />If you do not want to participate in this survey and do not want to receive any more invitations, please click the following link:<br />{OPTOUTURL}]]></surveyls_email_invite>
    <surveyls_email_remind_subj><![CDATA[Reminder to participate in a survey: {SURVEYNAME}]]></surveyls_email_remind_subj>
    <surveyls_email_remind><![CDATA[Dear {FIRSTNAME},<br /><br />recently we invited you to take part in the survey "{SURVEYNAME}". We have not received your answers yet — the survey is still available:<br />{SURVEYURL}<br /><br />Sincerely,<br />{ADMINNAME} ({ADMINEMAIL})<br /><br />----------------------------------------------<br />If you do not want to receive any more reminders, please click the following link:<br />{OPTOUTURL}]]></surveyls_email_remind>
    <surveyls_email_register_subj><![CDATA[Survey registration confirmation: {SURVEYNAME}]]></surveyls_email_register_subj>
    <surveyls_email_register><![CDATA[Dear {FIRSTNAME},<br /><br />thank you for registering for the survey "{SURVEYNAME}". To take part, please click the link below:<br />{SURVEYURL}<br /><br />Sincerely,<br />{ADMINNAME} ({ADMINEMAIL})]]></surveyls_email_register>
    <surveyls_email_confirm_subj><![CDATA[Confirmation of your participation in our survey: {SURVEYNAME}]]></surveyls_email_confirm_subj>
    <surveyls_email_confirm><![CDATA[Dear {FIRSTNAME},<br /><br />thank you for completing the survey "{SURVEYNAME}". Your answers have been saved.<br /><br />Sincerely,<br />{ADMINNAME}]]></surveyls_email_confirm>
    <surveyls_dateformat><![CDATA[9]]></surveyls_dateformat>
    <surveyls_attributecaptions><![CDATA[]]></surveyls_attributecaptions>
    <surveyls_numberformat><![CDATA[0]]></surveyls_numberformat>
   </row>
  </rows>
 </surveys_languagesettings>
</document>
