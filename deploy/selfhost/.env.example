# Access key used to sign in to LimeControl (minimum 16 characters).
# Generate one with:  openssl rand -base64 24
LIMECONTROL_ACCESS_KEY=

# Port on 127.0.0.1 where the app is published (standalone compose.yaml only).
LIMECONTROL_PORT=8080

# 1 = allow the relay/scheduler to reach private addresses (LimeSurvey in your LAN or Docker network).
RELAY_ALLOW_PRIVATE=1

# Optional: secret for encrypting stored job passwords (default: a key file in the data volume).
LIMECONTROL_SECRET=

# --- compose.with-stack.yaml only ---
# Domain for LimeControl (DNS must point at this server) and the name of the LimeSurvey stack.
LIMECONTROL_DOMAIN=control.example.com
STACK_NAME=limesurvey
